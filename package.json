{
  "name": "gitasks",
  "version": "0.4.0",
  "description": "A lightweight local task protocol for humans and coding agents, powered entirely by GitHub Issues.",
  "type": "module",
  "bin": {
    "gitasks": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/cli.js",
    "dist/ui/app.js",
    "dist/ui/index.html",
    "dist/ui/styles.css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/cli.ts",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run verify:package"
  },
  "keywords": [
    "github-issues",
    "task-management",
    "cli",
    "coding-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilalnrts/gitasks.git"
  },
  "bugs": {
    "url": "https://github.com/bilalnrts/gitasks/issues"
  },
  "homepage": "https://github.com/bilalnrts/gitasks#readme",
  "dependencies": {
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
